// Iris reads these defines to build the Shader Pack Settings menu.
// Defaults preserve the incoming scene. Temperature/tint are artistic offsets.
#define EXPOSURE 0.0 // [-2.0 -1.5 -1.0 -0.5 -0.25 0.0 0.25 0.5 1.0 1.5 2.0] Exposure in stops.
#define SATURATION 1.0 // [0.0 0.25 0.5 0.75 1.0 1.25 1.5 1.75 2.0] Color intensity.
#define CONTRAST 1.0 // [0.5 0.75 0.9 1.0 1.1 1.25 1.5] Contrast around display mid-gray.
#define TEMPERATURE 0.0 // [-1.0 -0.75 -0.5 -0.25 0.0 0.25 0.5 0.75 1.0] Negative cools, positive warms.
#define TINT 0.0 // [-1.0 -0.75 -0.5 -0.25 0.0 0.25 0.5 0.75 1.0] Negative green, positive magenta.
